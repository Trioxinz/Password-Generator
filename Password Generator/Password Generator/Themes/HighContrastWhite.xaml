<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" InvalidatesImplicitDataTemplateResources="False">

    <SolidColorBrush x:Key="Window.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Window.Forground" Color="#000000" />


    <SolidColorBrush x:Key="Label.Background" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="Label.Forground" Color="#000000" />


    <SolidColorBrush x:Key="TextBox.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBox.BorderBrush" Color="#37006E" />
    <SolidColorBrush x:Key="TextBox.Forground" Color="#000000" />
    <SolidColorBrush x:Key="TextBox.SelectionBrush" Color="#37006E" />
    <SolidColorBrush x:Key="TextBox.SelectionTextBrush" Color="#FFFFFF" />


    <SolidColorBrush x:Key="RichTextBox.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RichTextBox.BorderBrush" Color="#37006E" />
    <SolidColorBrush x:Key="RichTextBox.Forground" Color="#000000" />
    <SolidColorBrush x:Key="RichTextBox.SelectionBrush" Color="#37006E" />
    <SolidColorBrush x:Key="RichTextBox.SelectionTextBrush" Color="#FFFFFF" />


    <SolidColorBrush x:Key="ProgressBar.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ProgressBar.BorderBrush" Color="#37006E" />


    <!-- Define the CheckBox Style -->
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Style.Triggers>
            <!-- Trigger for Checked state -->
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="#000000"/>
            </DataTrigger>
            <!-- Trigger for Unchecked state -->
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="#000000"/>
            </DataTrigger>
        </Style.Triggers>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <!-- Custom CheckBox Visual -->
                        <Border x:Name="CheckBorder"
                                Width="13" Height="13"
                                BorderBrush="#37006E"
                                BorderThickness="1"
                                CornerRadius="0"
                                Background="#FFFFFF">
                            <Grid>
                                <!-- The X Glyph -->
                                <!--
                                <Path x:Name="CheckMark"
                                      Data="M 0,0 L 7,7 M 0,7 L 7,0"
                                      Stroke="Black" StrokeThickness="2"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                                -->

                                <!-- The Checkmark Glyph -->
                                <Path x:Name="CheckMark"
                                      Data="M 2,7 L 5,9 L 9,2"
                                      Stroke="Black" StrokeThickness="2"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <!-- Text Content -->
                        <ContentPresenter VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- Visual States -->
                    <ControlTemplate.Triggers>
                        <!-- Checked State: Show checkmark and change color -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="CheckMark" Property="Stroke" Value="#000000"/>
                            <!-- Change glyph color -->
                        </Trigger>

                        <!-- Unchecked State: Hide checkmark -->
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- MouseOver Effect -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#5D00BA"/>
                        </Trigger>

                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckBorder" Property="Background" Value="#FFFFFF" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#600000"/>
                            <Setter TargetName="CheckMark" Property="Stroke" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Define the Button Style -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/> 
        <Setter Property="BorderBrush" Value="#37006E"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Mouse Over Effect -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#37006E"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>

                        <!-- Button Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#000000"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>

                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#600000"/>
                            <Setter Property="Foreground" Value="#000000"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Define the ComboBox Style -->
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#37006E"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Main Border -->
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <!-- Grid for Layout: Column 0 (Content) | Column 1 (Arrow Button) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <!-- Content Area -->
                                    <ColumnDefinition Width="17"/>
                                    <!-- Arrow Button Area -->
                                </Grid.ColumnDefinitions>

                                <!-- Full-Width Clickable Area -->
                                <ToggleButton x:Name="MainClickArea"
                                              Grid.ColumnSpan="2"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                                <!-- Content Presenter (Displays Selected Item) -->
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  VerticalAlignment="Center"
                                                  Margin="5,0,0,0"
                                                   IsHitTestVisible="False"/>
                                <!-- Prevents click interference -->

                                <!-- DropDown Button (Moves Arrow to Right) -->
                                <ToggleButton x:Name="DropDownButton"
                                              Grid.Column="1"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Grid HorizontalAlignment="Right">
                                        <!-- Arrow Path (Now Positioned to the Right) -->
                                        <!-- Data="M 3 6 L 9 12 L 15 6" -->
                                        <Path x:Name="Arrow"
                                              Data="M 0 0 L 2 2 L 4 0"
                                              Stroke="#000000"
                                              StrokeThickness="1"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="5,0,5,0"/>
                                    </Grid>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <!-- Popup List -->
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Focusable="False">
                            <Border Background="#FFFFFF" 
                                    BorderBrush="#000000" 
                                    BorderThickness="2" 
                                    CornerRadius="5"
                                    
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <!-- Ensure dropdown is at least as wide as ComboBox -->
                                <!--
                                <ScrollViewer MaxHeight="475"> is the same as Microsoft's setting
                                -->
                                <ScrollViewer MaxHeight="404">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Triggers for States -->
                    <ControlTemplate.Triggers>
                        <!-- Hover Effect -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#37006E"/>
                        </Trigger>

                        <!-- Dropdown Open Effect -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#37006E"/>
                            <Setter TargetName="Arrow" Property="Stroke" Value="#000000"/>
                            <!-- Arrow color change -->
                        </Trigger>

                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="#000000"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#000000"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>